# ===================================================================
# ALPHABIKE STORE & TALLER - CONFIGURACIÓN DE ENTORNO
# ===================================================================

# 1. URL de la API del Backend (Spring Boot)
VITE_API_URL=http://localhost:8080/api/v1

# ===================================================================
# 2. ARQUITECTURA DE PASARELA DE PAGO (PLUG & PLAY)
# ===================================================================
# Actualmente configurado en modo SANDBOX con simulación bancaria completa:
# - Validación real de tarjetas con algoritmo de Luhn (Visa, Mastercard, Amex, Diners)
# - Generación instantánea de QRs dinámicos Yape / Plin con código de verificación
# - Cuentas bancarias BCP / BBVA / Interbank con CCI y copia rápida
# - Generación de vouchers y comprobantes con cálculo de I.G.V. (18%)
# - Registro y auditoría en el panel administrativo

# Proveedor activo: 'SANDBOX' | 'CULQI' | 'MERCADOPAGO' | 'STRIPE'
VITE_PAYMENT_GATEWAY_PROVIDER=SANDBOX

# Entorno: 'test' | 'production'
VITE_PAYMENT_ENV=test

# -------------------------------------------------------------------
# INSERCIÓN DE PASARELA REAL (Cuando tengas tus credenciales comerciales):
# Solamente descomenta y completa las siguientes variables con tus llaves:
# -------------------------------------------------------------------

# Si usas CULQI (Perú):
# VITE_PAYMENT_GATEWAY_PROVIDER=CULQI
# VITE_PAYMENT_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# VITE_CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Si usas MERCADO PAGO:
# VITE_PAYMENT_GATEWAY_PROVIDER=MERCADOPAGO
# VITE_PAYMENT_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Si usas STRIPE:
# VITE_PAYMENT_GATEWAY_PROVIDER=STRIPE
# VITE_PAYMENT_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# ===================================================================
# ALPHABIKE STORE & TALLER - CONFIGURACIÓN DE ENTORNO
# ===================================================================

# 1. URL de la API del Backend (Spring Boot)
VITE_API_URL=http://localhost:8080/api/v1

# ===================================================================
# 2. PROVEEDOR DE PAGO PARA DEMOSTRACION
# ===================================================================
# SANDBOX simula la interfaz de pago y registra el resultado en el backend.
# No procesa dinero real ni debe usarse como pasarela de produccion.

# Actualmente solo se admite SANDBOX. Otro valor falla de forma explicita hasta
# implementar el SDK y la verificacion servidor-a-servidor del proveedor real.
VITE_PAYMENT_GATEWAY_PROVIDER=SANDBOX

# Entorno: 'test' | 'production'
VITE_PAYMENT_ENV=test

# Las llaves secretas de una integracion real pertenecen al backend, nunca a Vite.
